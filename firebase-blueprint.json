{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Authenticated user's private recruiting payroll workspace root document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the workspace owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of the workspace owner."
        },
        "seededDemo": {
          "type": "boolean",
          "description": "Whether initial sample records have been seeded."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when workspace was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when workspace was last updated."
        }
      },
      "required": ["uid", "displayName", "seededDemo", "createdAt", "updatedAt"]
    },
    "CommissionRules": {
      "title": "CommissionRules",
      "description": "Automatic base commission rate and milestone bonus rules for a workspace.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "defaultCommissionRatePct": {
          "type": "number"
        },
        "highPayBonusThreshold": {
          "type": "number"
        },
        "highPayBonusAmount": {
          "type": "number"
        },
        "tierAcceleratorThreshold": {
          "type": "number"
        },
        "tierAcceleratorRatePct": {
          "type": "number"
        },
        "retentionMilestoneBonusAmount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "defaultCommissionRatePct",
        "highPayBonusThreshold",
        "highPayBonusAmount",
        "tierAcceleratorThreshold",
        "tierAcceleratorRatePct",
        "retentionMilestoneBonusAmount",
        "createdAt",
        "updatedAt"
      ]
    },
    "Recruit": {
      "title": "Recruit",
      "description": "A recruited employee placed at a company with commission terms and payment method.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "company": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "startDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "commissionModel": {
          "type": "string",
          "enum": ["percentage", "flat"]
        },
        "customCommissionValue": {
          "type": "number"
        },
        "preferredPaymentMethod": {
          "type": "string",
          "enum": ["ACH Direct Deposit", "Wire Transfer", "Wise", "PayPal", "Check"]
        },
        "paymentAccountDetail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "role",
        "company",
        "email",
        "startDate",
        "commissionModel",
        "preferredPaymentMethod",
        "paymentAccountDetail",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "PayoutRecord": {
      "title": "PayoutRecord",
      "description": "Recorded employee payout with auto-calculated commissions, bonuses, and payment method.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recruitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "payDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "payPeriodLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "grossEmployeePay": {
          "type": "number"
        },
        "commissionModel": {
          "type": "string",
          "enum": ["percentage", "flat"]
        },
        "commissionRateOrFlat": {
          "type": "number"
        },
        "baseCommissionAmount": {
          "type": "number"
        },
        "bonuses": {
          "type": "array"
        },
        "totalBonusAmount": {
          "type": "number"
        },
        "totalRecruiterEarnings": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["ACH Direct Deposit", "Wire Transfer", "Wise", "PayPal", "Check"]
        },
        "paymentAccountDetail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "referenceCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["Paid", "Scheduled", "Pending", "On Hold"]
        },
        "isRetentionMilestone": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "recruitId",
        "payDate",
        "payPeriodLabel",
        "grossEmployeePay",
        "commissionModel",
        "commissionRateOrFlat",
        "baseCommissionAmount",
        "bonuses",
        "totalBonusAmount",
        "totalRecruiterEarnings",
        "paymentMethod",
        "paymentAccountDetail",
        "referenceCode",
        "status",
        "isRetentionMilestone",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "PerformanceTarget": {
      "title": "PerformanceTarget",
      "description": "Monthly recruitment pay goal and commission multiplier configuration per employee.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recruitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "monthlyPayGoal": {
          "type": "number"
        },
        "multiplierFactor": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "recruitId",
        "monthlyPayGoal",
        "multiplierFactor",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "Applicant": {
      "title": "Applicant",
      "description": "Prospective candidate tracked in the recruiting pipeline prior to placement.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "targetRole": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "targetCompany": {
          "type": "string",
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "maxLength": 80
        },
        "appliedDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "expectedSalary": {
          "type": "number"
        },
        "stage": {
          "type": "string",
          "enum": ["New", "Screening", "Interview", "Offer", "Hired", "Rejected"]
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "convertedRecruitId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "email",
        "phone",
        "targetRole",
        "targetCompany",
        "source",
        "appliedDate",
        "expectedSalary",
        "stage",
        "notes",
        "convertedRecruitId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExamForm": {
      "title": "ExamForm",
      "description": "Linked or created Google Form used to administer the Duolingo 100+ and anti-AI screening exam.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "googleFormId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "testType": {
          "type": "string",
          "enum": ["english_comm", "analytical_logic", "technical_ops", "role_scenario"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "responderUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "editUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "qFullName": { "type": "string", "maxLength": 120 },
        "qEmail": { "type": "string", "maxLength": 120 },
        "qTargetRole": { "type": "string", "maxLength": 120 },
        "qDuolingoScore": { "type": "string", "maxLength": 120 },
        "qDuolingoProof": { "type": "string", "maxLength": 120 },
        "qScenario": { "type": "string", "maxLength": 120 },
        "qTrickConstraint": { "type": "string", "maxLength": 120 },
        "qTrickLogic": { "type": "string", "maxLength": 120 },
        "qTrickCanary": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "googleFormId",
        "testType",
        "title",
        "responderUri",
        "editUrl",
        "qFullName",
        "qEmail",
        "qTargetRole",
        "qDuolingoScore",
        "qDuolingoProof",
        "qScenario",
        "qTrickConstraint",
        "qTrickLogic",
        "qTrickCanary",
        "createdAt",
        "updatedAt"
      ]
    },
    "ExamSubmission": {
      "title": "ExamSubmission",
      "description": "Analyzed applicant exam submission including Duolingo verification, anti-AI trick checks, and Gemini authenticity review.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "googleFormId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "testType": {
          "type": "string",
          "enum": ["english_comm", "analytical_logic", "technical_ops", "role_scenario"]
        },
        "responseId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "applicantName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "applicantEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "targetRole": { "type": "string", "maxLength": 120 },
        "duolingoScore": { "type": "number" },
        "duolingoProof": { "type": "string", "maxLength": 300 },
        "duolingoPassed": { "type": "boolean" },
        "canaryTriggered": { "type": "boolean" },
        "trickQuestionsPassed": { "type": "boolean" },
        "aiLikelihoodPct": { "type": "number" },
        "aiSuspected": { "type": "boolean" },
        "qualityScore": { "type": "number" },
        "passed": { "type": "boolean" },
        "flags": { "type": "array" },
        "summary": { "type": "string", "maxLength": 500 },
        "inviteCode": {
          "type": "string",
          "pattern": "^CAD-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "googleFormId",
        "testType",
        "responseId",
        "applicantName",
        "applicantEmail",
        "targetRole",
        "duolingoScore",
        "duolingoProof",
        "duolingoPassed",
        "canaryTriggered",
        "trickQuestionsPassed",
        "aiLikelihoodPct",
        "aiSuspected",
        "qualityScore",
        "passed",
        "flags",
        "summary",
        "inviteCode",
        "submittedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ApplicantTestAssignment": {
      "title": "ApplicantTestAssignment",
      "description": "Automatic assignment linking an applicant to one of the 4 Google Forms screening tests and tracking completion status.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "applicantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "applicantName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "applicantEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "testType": {
          "type": "string",
          "enum": ["english_comm", "analytical_logic", "technical_ops", "role_scenario"]
        },
        "googleFormId": { "type": "string", "maxLength": 160 },
        "formTitle": { "type": "string", "maxLength": 160 },
        "responderUri": { "type": "string", "maxLength": 500 },
        "status": {
          "type": "string",
          "enum": ["Assigned", "Passed", "Failed"]
        },
        "submissionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "duolingoScore": { "type": "number" },
        "aiLikelihoodPct": { "type": "number" },
        "qualityScore": { "type": "number" },
        "assignedAt": { "type": "string", "maxLength": 64 },
        "completedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerId",
        "applicantId",
        "applicantName",
        "applicantEmail",
        "testType",
        "googleFormId",
        "formTitle",
        "responderUri",
        "status",
        "submissionId",
        "duolingoScore",
        "aiLikelihoodPct",
        "qualityScore",
        "assignedAt",
        "completedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "ApplicantInvite": {
      "title": "ApplicantInvite",
      "description": "Single-use registration code issued to a passing applicant allowing Cadence account creation.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^CAD-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "recruiterUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "applicantName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "applicantEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "targetRole": { "type": "string", "maxLength": 120 },
        "duolingoScore": { "type": "number" },
        "examScore": { "type": "number" },
        "aiLikelihoodPct": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["Active", "Used", "Revoked"]
        },
        "usedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "code",
        "recruiterUid",
        "applicantName",
        "applicantEmail",
        "targetRole",
        "duolingoScore",
        "examScore",
        "aiLikelihoodPct",
        "status",
        "usedByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ApplicantProfile": {
      "title": "ApplicantProfile",
      "description": "Authenticated applicant account profile created after passing the exam and redeeming a recruiter-issued registration code.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recruiterUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "inviteCode": {
          "type": "string",
          "pattern": "^CAD-[A-Z0-9]{4}-[A-Z0-9]{4}$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "targetRole": { "type": "string", "maxLength": 120 },
        "duolingoScore": { "type": "number" },
        "examScore": { "type": "number" },
        "aiLikelihoodPct": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["Approved"]
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "recruiterUid",
        "inviteCode",
        "name",
        "email",
        "targetRole",
        "duolingoScore",
        "examScore",
        "aiLikelihoodPct",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Owner-isolated workspace root document."
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CommissionRules" },
      "description": "Automatic commission and bonus configuration per workspace."
    },
    "/users/{userId}/recruits/{recruitId}": {
      "schema": { "$ref": "#/entities/Recruit" },
      "description": "Recruited employees and their payment method details."
    },
    "/users/{userId}/payouts/{payoutId}": {
      "schema": { "$ref": "#/entities/PayoutRecord" },
      "description": "Recorded employee payout ledger with calculated commissions and bonuses."
    },
    "/users/{userId}/performanceTargets/{targetId}": {
      "schema": { "$ref": "#/entities/PerformanceTarget" },
      "description": "Monthly recruitment goals and commission multipliers per recruited employee."
    },
    "/users/{userId}/applicants/{applicantId}": {
      "schema": { "$ref": "#/entities/Applicant" },
      "description": "Prospective job applicants tracked across recruitment pipeline stages."
    },
    "/users/{userId}/examForms/{formId}": {
      "schema": { "$ref": "#/entities/ExamForm" },
      "description": "Google Forms linked to the recruiter workspace for Duolingo 100+ and anti-AI screening exams."
    },
    "/users/{userId}/examSubmissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ExamSubmission" },
      "description": "Analyzed screening exam submissions with Duolingo verification and AI detection results."
    },
    "/users/{userId}/applicantTests/{assignmentId}": {
      "schema": { "$ref": "#/entities/ApplicantTestAssignment" },
      "description": "Per-applicant automatic assignments across all 4 Google Forms screening tests."
    },
    "/applicantInvites/{code}": {
      "schema": { "$ref": "#/entities/ApplicantInvite" },
      "description": "Recruiter-issued single-use registration codes gating applicant account creation."
    },
    "/applicantProfiles/{userId}": {
      "schema": { "$ref": "#/entities/ApplicantProfile" },
      "description": "Approved applicant account profiles linked to a redeemed invite code."
    }
  }
}
