rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isDesignatedOwner() {
      return isSignedIn() && request.auth.uid == '82SIYo8O2hdtNqBAH8stAkPBZYq2';
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        isDesignatedOwner()
      );
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isNumberInRange(val, minVal, maxVal) {
      return (val is int || val is float) && val >= minVal && val <= maxVal;
    }

    function isValidPaymentMethod(method) {
      return method is string && method.size() <= 32 &&
        method in ['ACH Direct Deposit', 'Wire Transfer', 'Wise', 'PayPal', 'Check'];
    }

    function isValidPayoutStatus(status) {
      return status is string && status.size() <= 16 &&
        status in ['Paid', 'Scheduled', 'Pending', 'On Hold'];
    }

    function isValidCommissionModel(model) {
      return model is string && model.size() <= 16 &&
        model in ['percentage', 'flat'];
    }

    function isValidApplicantStage(stage) {
      return stage is string && stage.size() <= 16 &&
        stage in ['New', 'Screening', 'Interview', 'Offer', 'Hired', 'Rejected'];
    }

    function isValidIsoDate(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidInviteCode(code) {
      return code is string && code.size() == 13 && code.matches('^CAD-[A-Z0-9]{4}-[A-Z0-9]{4}$');
    }

    function isValidInviteStatus(status) {
      return status is string && status.size() <= 16 &&
        status in ['Active', 'Used', 'Revoked'];
    }

    function isValidFlagList(flags) {
      return flags is list && flags.size() <= 10 &&
        (flags.size() == 0 || (flags[0] is string && flags[0].size() <= 300));
    }

    function isValidExamTestType(testType) {
      return testType is string && testType.size() <= 32 &&
        testType in ['english_comm', 'analytical_logic', 'technical_ops', 'role_scenario'];
    }

    function isValidTestAssignmentStatus(status) {
      return status is string && status.size() <= 16 &&
        status in ['Assigned', 'Passed', 'Failed'];
    }

    // --- Entity Validation Blueprints (create + update) ---
    function isValidUserWorkspace(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'seededDemo', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'seededDemo', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.seededDemo is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCommissionRules(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'defaultCommissionRatePct', 'highPayBonusThreshold',
          'highPayBonusAmount', 'tierAcceleratorThreshold', 'tierAcceleratorRatePct',
          'retentionMilestoneBonusAmount', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'defaultCommissionRatePct', 'highPayBonusThreshold',
          'highPayBonusAmount', 'tierAcceleratorThreshold', 'tierAcceleratorRatePct',
          'retentionMilestoneBonusAmount', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isNumberInRange(data.defaultCommissionRatePct, 0, 100) &&
        isNumberInRange(data.highPayBonusThreshold, 0, 10000000) &&
        isNumberInRange(data.highPayBonusAmount, 0, 1000000) &&
        isNumberInRange(data.tierAcceleratorThreshold, 0, 100000000) &&
        isNumberInRange(data.tierAcceleratorRatePct, 0, 100) &&
        isNumberInRange(data.retentionMilestoneBonusAmount, 0, 1000000) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidRecruit(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'name', 'role', 'company', 'email', 'startDate',
          'commissionModel', 'customCommissionValue', 'preferredPaymentMethod',
          'paymentAccountDetail', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'name', 'role', 'company', 'email', 'startDate',
          'commissionModel', 'customCommissionValue', 'preferredPaymentMethod',
          'paymentAccountDetail', 'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 120 &&
        data.company is string && data.company.size() >= 1 && data.company.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        isValidIsoDate(data.startDate) &&
        isValidCommissionModel(data.commissionModel) &&
        (data.customCommissionValue == null || isNumberInRange(data.customCommissionValue, 0, 1000000)) &&
        isValidPaymentMethod(data.preferredPaymentMethod) &&
        data.paymentAccountDetail is string && data.paymentAccountDetail.size() >= 1 && data.paymentAccountDetail.size() <= 160 &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidBonusList(bonuses) {
      return bonuses is list && bonuses.size() <= 10 &&
        (bonuses.size() == 0 || (
          bonuses[0] is map &&
          bonuses[0].keys().hasAll(['id', 'label', 'amount']) &&
          bonuses[0].keys().hasOnly(['id', 'label', 'amount']) &&
          bonuses[0].id is string && bonuses[0].id.size() >= 1 && bonuses[0].id.size() <= 64 &&
          bonuses[0].label is string && bonuses[0].label.size() >= 1 && bonuses[0].label.size() <= 160 &&
          isNumberInRange(bonuses[0].amount, 0, 1000000)
        ));
    }

    function isValidPayout(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'recruitId', 'payDate', 'payPeriodLabel', 'grossEmployeePay',
          'commissionModel', 'commissionRateOrFlat', 'baseCommissionAmount',
          'bonuses', 'totalBonusAmount', 'totalRecruiterEarnings',
          'paymentMethod', 'paymentAccountDetail', 'referenceCode',
          'status', 'isRetentionMilestone', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'recruitId', 'payDate', 'payPeriodLabel', 'grossEmployeePay',
          'commissionModel', 'commissionRateOrFlat', 'baseCommissionAmount',
          'bonuses', 'totalBonusAmount', 'totalRecruiterEarnings',
          'paymentMethod', 'paymentAccountDetail', 'referenceCode',
          'status', 'isRetentionMilestone', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isValidId(data.recruitId) &&
        isValidIsoDate(data.payDate) &&
        data.payPeriodLabel is string && data.payPeriodLabel.size() >= 1 && data.payPeriodLabel.size() <= 80 &&
        isNumberInRange(data.grossEmployeePay, 0, 10000000) &&
        isValidCommissionModel(data.commissionModel) &&
        isNumberInRange(data.commissionRateOrFlat, 0, 1000000) &&
        isNumberInRange(data.baseCommissionAmount, 0, 10000000) &&
        isValidBonusList(data.bonuses) &&
        isNumberInRange(data.totalBonusAmount, 0, 10000000) &&
        isNumberInRange(data.totalRecruiterEarnings, 0, 20000000) &&
        isValidPaymentMethod(data.paymentMethod) &&
        data.paymentAccountDetail is string && data.paymentAccountDetail.size() >= 1 && data.paymentAccountDetail.size() <= 160 &&
        data.referenceCode is string && data.referenceCode.size() >= 3 && data.referenceCode.size() <= 32 &&
        data.referenceCode.matches('^[A-Z0-9\\-]+$') &&
        isValidPayoutStatus(data.status) &&
        data.isRetentionMilestone is bool &&
        data.notes is string && data.notes.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPerformanceTarget(data, userId, targetId) {
      return data.keys().hasAll([
          'ownerId', 'recruitId', 'monthlyPayGoal', 'multiplierFactor',
          'active', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'recruitId', 'monthlyPayGoal', 'multiplierFactor',
          'active', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isValidId(data.recruitId) &&
        data.recruitId == targetId &&
        isNumberInRange(data.monthlyPayGoal, 0, 10000000) &&
        isNumberInRange(data.multiplierFactor, 1, 5) &&
        data.active is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidApplicant(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'name', 'email', 'phone', 'targetRole', 'targetCompany',
          'source', 'appliedDate', 'expectedSalary', 'stage', 'notes',
          'convertedRecruitId', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'name', 'email', 'phone', 'targetRole', 'targetCompany',
          'source', 'appliedDate', 'expectedSalary', 'stage', 'notes',
          'convertedRecruitId', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.targetRole is string && data.targetRole.size() >= 1 && data.targetRole.size() <= 120 &&
        data.targetCompany is string && data.targetCompany.size() <= 120 &&
        data.source is string && data.source.size() <= 80 &&
        isValidIsoDate(data.appliedDate) &&
        isNumberInRange(data.expectedSalary, 0, 10000000) &&
        isValidApplicantStage(data.stage) &&
        data.notes is string && data.notes.size() <= 500 &&
        (data.convertedRecruitId == null || isValidId(data.convertedRecruitId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExamForm(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'googleFormId', 'testType', 'title', 'responderUri', 'editUrl',
          'qFullName', 'qEmail', 'qTargetRole', 'qDuolingoScore', 'qDuolingoProof',
          'qScenario', 'qTrickConstraint', 'qTrickLogic', 'qTrickCanary',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'googleFormId', 'testType', 'title', 'responderUri', 'editUrl',
          'qFullName', 'qEmail', 'qTargetRole', 'qDuolingoScore', 'qDuolingoProof',
          'qScenario', 'qTrickConstraint', 'qTrickLogic', 'qTrickCanary',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.googleFormId is string && data.googleFormId.size() >= 1 && data.googleFormId.size() <= 160 &&
        isValidExamTestType(data.testType) &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.responderUri is string && data.responderUri.size() >= 1 && data.responderUri.size() <= 500 &&
        data.editUrl is string && data.editUrl.size() >= 1 && data.editUrl.size() <= 500 &&
        data.qFullName is string && data.qFullName.size() <= 120 &&
        data.qEmail is string && data.qEmail.size() <= 120 &&
        data.qTargetRole is string && data.qTargetRole.size() <= 120 &&
        data.qDuolingoScore is string && data.qDuolingoScore.size() <= 120 &&
        data.qDuolingoProof is string && data.qDuolingoProof.size() <= 120 &&
        data.qScenario is string && data.qScenario.size() <= 120 &&
        data.qTrickConstraint is string && data.qTrickConstraint.size() <= 120 &&
        data.qTrickLogic is string && data.qTrickLogic.size() <= 120 &&
        data.qTrickCanary is string && data.qTrickCanary.size() <= 120 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidExamSubmission(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'googleFormId', 'testType', 'responseId', 'applicantName', 'applicantEmail',
          'targetRole', 'duolingoScore', 'duolingoProof', 'duolingoPassed',
          'canaryTriggered', 'trickQuestionsPassed', 'aiLikelihoodPct', 'aiSuspected',
          'qualityScore', 'passed', 'flags', 'summary', 'inviteCode', 'submittedAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'googleFormId', 'testType', 'responseId', 'applicantName', 'applicantEmail',
          'targetRole', 'duolingoScore', 'duolingoProof', 'duolingoPassed',
          'canaryTriggered', 'trickQuestionsPassed', 'aiLikelihoodPct', 'aiSuspected',
          'qualityScore', 'passed', 'flags', 'summary', 'inviteCode', 'submittedAt',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        data.googleFormId is string && data.googleFormId.size() >= 1 && data.googleFormId.size() <= 160 &&
        isValidExamTestType(data.testType) &&
        data.responseId is string && data.responseId.size() >= 1 && data.responseId.size() <= 160 &&
        data.applicantName is string && data.applicantName.size() >= 1 && data.applicantName.size() <= 120 &&
        data.applicantEmail is string && data.applicantEmail.size() >= 3 && data.applicantEmail.size() <= 160 &&
        data.targetRole is string && data.targetRole.size() <= 120 &&
        isNumberInRange(data.duolingoScore, 0, 160) &&
        data.duolingoProof is string && data.duolingoProof.size() <= 300 &&
        data.duolingoPassed is bool &&
        data.canaryTriggered is bool &&
        data.trickQuestionsPassed is bool &&
        isNumberInRange(data.aiLikelihoodPct, 0, 100) &&
        data.aiSuspected is bool &&
        isNumberInRange(data.qualityScore, 0, 100) &&
        data.passed is bool &&
        isValidFlagList(data.flags) &&
        data.summary is string && data.summary.size() <= 500 &&
        (data.inviteCode == null || isValidInviteCode(data.inviteCode)) &&
        data.submittedAt is string && data.submittedAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidApplicantTestAssignment(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'applicantId', 'applicantName', 'applicantEmail', 'testType',
          'googleFormId', 'formTitle', 'responderUri', 'status', 'submissionId',
          'duolingoScore', 'aiLikelihoodPct', 'qualityScore', 'assignedAt',
          'completedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'applicantId', 'applicantName', 'applicantEmail', 'testType',
          'googleFormId', 'formTitle', 'responderUri', 'status', 'submissionId',
          'duolingoScore', 'aiLikelihoodPct', 'qualityScore', 'assignedAt',
          'completedAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.ownerId) &&
        data.ownerId == userId &&
        data.ownerId == request.auth.uid &&
        isValidId(data.applicantId) &&
        data.applicantName is string && data.applicantName.size() >= 1 && data.applicantName.size() <= 120 &&
        data.applicantEmail is string && data.applicantEmail.size() >= 3 && data.applicantEmail.size() <= 160 &&
        isValidExamTestType(data.testType) &&
        data.googleFormId is string && data.googleFormId.size() <= 160 &&
        data.formTitle is string && data.formTitle.size() <= 160 &&
        data.responderUri is string && data.responderUri.size() <= 500 &&
        isValidTestAssignmentStatus(data.status) &&
        (data.submissionId == null || isValidId(data.submissionId)) &&
        isNumberInRange(data.duolingoScore, 0, 160) &&
        isNumberInRange(data.aiLikelihoodPct, 0, 100) &&
        isNumberInRange(data.qualityScore, 0, 100) &&
        data.assignedAt is string && data.assignedAt.size() <= 64 &&
        data.completedAt is string && data.completedAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidApplicantInvite(data, code) {
      return data.keys().hasAll([
          'code', 'recruiterUid', 'applicantName', 'applicantEmail', 'targetRole',
          'duolingoScore', 'examScore', 'aiLikelihoodPct', 'status', 'usedByUid',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'code', 'recruiterUid', 'applicantName', 'applicantEmail', 'targetRole',
          'duolingoScore', 'examScore', 'aiLikelihoodPct', 'status', 'usedByUid',
          'createdAt', 'updatedAt'
        ]) &&
        isValidInviteCode(data.code) &&
        data.code == code &&
        isValidId(data.recruiterUid) &&
        data.applicantName is string && data.applicantName.size() >= 1 && data.applicantName.size() <= 120 &&
        data.applicantEmail is string && data.applicantEmail.size() >= 3 && data.applicantEmail.size() <= 160 &&
        data.targetRole is string && data.targetRole.size() <= 120 &&
        isNumberInRange(data.duolingoScore, 100, 160) &&
        isNumberInRange(data.examScore, 0, 100) &&
        isNumberInRange(data.aiLikelihoodPct, 0, 100) &&
        isValidInviteStatus(data.status) &&
        (data.usedByUid == null || isValidId(data.usedByUid)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidApplicantProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'recruiterUid', 'inviteCode', 'name', 'email', 'targetRole',
          'duolingoScore', 'examScore', 'aiLikelihoodPct', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'recruiterUid', 'inviteCode', 'name', 'email', 'targetRole',
          'duolingoScore', 'examScore', 'aiLikelihoodPct', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        isValidId(data.recruiterUid) &&
        isValidInviteCode(data.inviteCode) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.targetRole is string && data.targetRole.size() <= 120 &&
        isNumberInRange(data.duolingoScore, 100, 160) &&
        isNumberInRange(data.examScore, 0, 100) &&
        isNumberInRange(data.aiLikelihoodPct, 0, 100) &&
        data.status == 'Approved' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Workspace & Subcollection Match Blocks ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId) && existing().uid == request.auth.uid;
      allow create: if isValidId(userId) && isOwner(userId) &&
        isValidUserWorkspace(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isOwner(userId) &&
        isValidUserWorkspace(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'seededDemo', 'updatedAt']);
      allow delete: if false;

      match /settings/{settingId} {
        allow get: if isValidId(userId) && isValidId(settingId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(settingId) && settingId == 'commissionRules' &&
          isOwner(userId) &&
          isValidCommissionRules(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(settingId) && settingId == 'commissionRules' &&
          isOwner(userId) &&
          isValidCommissionRules(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'defaultCommissionRatePct', 'highPayBonusThreshold', 'highPayBonusAmount',
            'tierAcceleratorThreshold', 'tierAcceleratorRatePct', 'retentionMilestoneBonusAmount',
            'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if false;
      }

      match /recruits/{recruitId} {
        allow get: if isValidId(userId) && isValidId(recruitId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(recruitId) &&
          isOwner(userId) &&
          isValidRecruit(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(recruitId) &&
          isOwner(userId) &&
          isValidRecruit(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'role', 'company', 'email', 'startDate',
            'commissionModel', 'customCommissionValue', 'preferredPaymentMethod',
            'paymentAccountDetail', 'active', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(recruitId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }

      match /payouts/{payoutId} {
        allow get: if isValidId(userId) && isValidId(payoutId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(payoutId) &&
          isOwner(userId) &&
          isValidPayout(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          existsAfter(/databases/$(database)/documents/users/$(userId)/recruits/$(incoming().recruitId));
        allow update: if isValidId(userId) && isValidId(payoutId) &&
          isOwner(userId) &&
          isValidPayout(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().recruitId == existing().recruitId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
          ) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(payoutId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }

      match /performanceTargets/{targetId} {
        allow get: if isValidId(userId) && isValidId(targetId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(targetId) &&
          isOwner(userId) &&
          isValidPerformanceTarget(incoming(), userId, targetId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          existsAfter(/databases/$(database)/documents/users/$(userId)/recruits/$(targetId));
        allow update: if isValidId(userId) && isValidId(targetId) &&
          isOwner(userId) &&
          isValidPerformanceTarget(incoming(), userId, targetId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().recruitId == existing().recruitId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'monthlyPayGoal', 'multiplierFactor', 'active', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(targetId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }

      match /applicants/{applicantId} {
        allow get: if isValidId(userId) && isValidId(applicantId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(applicantId) &&
          isOwner(userId) &&
          isValidApplicant(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(applicantId) &&
          isOwner(userId) &&
          isValidApplicant(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'email', 'phone', 'targetRole', 'targetCompany',
            'source', 'appliedDate', 'expectedSalary', 'stage', 'notes',
            'convertedRecruitId', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(applicantId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }

      match /examForms/{formId} {
        allow get: if isValidId(userId) && isValidId(formId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(formId) &&
          isOwner(userId) &&
          isValidExamForm(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(formId) &&
          isOwner(userId) &&
          isValidExamForm(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().googleFormId == existing().googleFormId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'testType', 'title', 'responderUri', 'editUrl', 'qFullName', 'qEmail',
            'qTargetRole', 'qDuolingoScore', 'qDuolingoProof', 'qScenario',
            'qTrickConstraint', 'qTrickLogic', 'qTrickCanary', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(formId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }

      match /examSubmissions/{submissionId} {
        allow get: if isValidId(userId) && isValidId(submissionId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(submissionId) &&
          isOwner(userId) &&
          isValidExamSubmission(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isValidId(userId) && isValidId(submissionId) &&
          isOwner(userId) &&
          isValidExamSubmission(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().googleFormId == existing().googleFormId &&
          incoming().testType == existing().testType &&
          incoming().responseId == existing().responseId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['inviteCode', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(submissionId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }

      match /applicantTests/{assignmentId} {
        allow get: if isValidId(userId) && isValidId(assignmentId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isValidId(userId) && isValidId(assignmentId) &&
          isOwner(userId) &&
          isValidApplicantTestAssignment(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId)) &&
          existsAfter(/databases/$(database)/documents/users/$(userId)/applicants/$(incoming().applicantId));
        allow update: if isValidId(userId) && isValidId(assignmentId) &&
          isOwner(userId) &&
          isValidApplicantTestAssignment(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().applicantId == existing().applicantId &&
          incoming().testType == existing().testType &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'applicantName', 'applicantEmail', 'googleFormId', 'formTitle',
            'responderUri', 'status', 'submissionId', 'duolingoScore',
            'aiLikelihoodPct', 'qualityScore', 'completedAt', 'updatedAt'
          ]) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow delete: if isValidId(userId) && isValidId(assignmentId) &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    match /applicantInvites/{code} {
      allow list: if isVerifiedUser() && existing().recruiterUid == request.auth.uid;
      allow get: if isValidInviteCode(code) && isSignedIn() && (
        isOwner(existing().recruiterUid) ||
        existing().usedByUid == request.auth.uid ||
        (
          existing().status == 'Active' &&
          request.auth.token.email != null &&
          existing().applicantEmail == request.auth.token.email.lower()
        )
      );
      allow create: if isValidInviteCode(code) &&
        isOwner(incoming().recruiterUid) &&
        isValidApplicantInvite(incoming(), code) &&
        incoming().status == 'Active' &&
        incoming().usedByUid == null &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().recruiterUid));
      allow update: if isValidInviteCode(code) &&
        isValidApplicantInvite(incoming(), code) &&
        incoming().code == existing().code &&
        incoming().recruiterUid == existing().recruiterUid &&
        incoming().applicantName == existing().applicantName &&
        incoming().applicantEmail == existing().applicantEmail &&
        incoming().targetRole == existing().targetRole &&
        incoming().duolingoScore == existing().duolingoScore &&
        incoming().examScore == existing().examScore &&
        incoming().aiLikelihoodPct == existing().aiLikelihoodPct &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isOwner(existing().recruiterUid) &&
            existing().status != 'Used' &&
            incoming().status in ['Active', 'Revoked'] &&
            incoming().usedByUid == existing().usedByUid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          ) ||
          (
            isSignedIn() &&
            existing().status == 'Active' &&
            existing().usedByUid == null &&
            request.auth.token.email != null &&
            existing().applicantEmail == request.auth.token.email.lower() &&
            incoming().status == 'Used' &&
            incoming().usedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'usedByUid', 'updatedAt']) &&
            existsAfter(/databases/$(database)/documents/applicantProfiles/$(request.auth.uid))
          )
        );
      allow delete: if isValidInviteCode(code) && isOwner(existing().recruiterUid);
    }

    match /applicantProfiles/{userId} {
      allow list: if isVerifiedUser() && existing().recruiterUid == request.auth.uid;
      allow get: if isValidId(userId) && isSignedIn() && (
        request.auth.uid == userId ||
        isOwner(existing().recruiterUid)
      );
      allow create: if isValidId(userId) &&
        isSignedIn() &&
        request.auth.uid == userId &&
        isValidApplicantProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        request.auth.token.email != null &&
        incoming().email == request.auth.token.email.lower() &&
        get(/databases/$(database)/documents/applicantInvites/$(incoming().inviteCode)).data.status == 'Active' &&
        get(/databases/$(database)/documents/applicantInvites/$(incoming().inviteCode)).data.applicantEmail == request.auth.token.email.lower() &&
        incoming().recruiterUid == get(/databases/$(database)/documents/applicantInvites/$(incoming().inviteCode)).data.recruiterUid &&
        incoming().duolingoScore == get(/databases/$(database)/documents/applicantInvites/$(incoming().inviteCode)).data.duolingoScore &&
        getAfter(/databases/$(database)/documents/applicantInvites/$(incoming().inviteCode)).data.status == 'Used' &&
        getAfter(/databases/$(database)/documents/applicantInvites/$(incoming().inviteCode)).data.usedByUid == request.auth.uid;
      allow update: if false;
      allow delete: if isValidId(userId) && isOwner(existing().recruiterUid);
    }
  }
}
